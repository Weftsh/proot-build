 	case PR_faccessat2:
 	case PR_futimesat:
 	case PR_mknodat:
+		/* fchmodat2 (Linux 6.6) is fchmodat with the flags argument
+		 * honoured; glibc 2.39 and GNU tar 1.35 use it for
+		 * AT_SYMLINK_NOFOLLOW.  Untranslated, it ran against the
+		 * kernel's cwd rather than the tracee's.  */
+		flags = (syscall_number == PR_fchmodat2)
+			? peek_reg(tracee, CURRENT, SYSARG_4)
+			: 0;
 		dirfd = peek_reg(tracee, CURRENT, SYSARG_1);
 
 		status = get_sysarg_path(tracee, path, SYSARG_2);
 		if (status < 0)
 			break;
 
